// --- MODEL UNTUK HISTORY TIMELINE ---
class StayPoint {
  final LatLng coord;
  final DateTime arrivalTime;
  DateTime departureTime;
  String placeName;
  bool isLoadingPlace;
  double distanceFromPrevious;
  bool isOnlineStart; // <-- Menandai ini adalah titik pertama saat user online

  StayPoint({
    required this.coord,
    required this.arrivalTime,
    required this.departureTime,
    required this.placeName,
    this.isLoadingPlace = true,
    this.distanceFromPrevious = 0.0,
    this.isOnlineStart = false,
  });
}


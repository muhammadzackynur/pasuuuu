  Widget _buildTimelineItem(StayPoint stay, bool isLast, bool isLatest) {
    // Label keterangan jarak / status titik
    String distanceText;
    if (stay.isOnlineStart && stay.distanceFromPrevious == 0.0) {
      // Titik pertama hari itu
      distanceText = 'Titik Awal (Started here)';
    } else if (stay.isOnlineStart) {
      // Online lagi setelah offline
      distanceText = 'Online kembali';
    } else if (stay.distanceFromPrevious > 0) {
      if (stay.distanceFromPrevious < 1.0) {
        distanceText =
            '${(stay.distanceFromPrevious * 1000).toInt()} meter dari posisi sebelumnya';
      } else {
        distanceText =
            '${stay.distanceFromPrevious.toStringAsFixed(1)} km dari posisi sebelumnya';
      }
    } else {
      distanceText = 'Titik Awal (Started here)';
    }

    return IntrinsicHeight(
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Dot & garis timeline
          Column(
            children: [
              Container(
                margin: const EdgeInsets.only(top: 4),
                width: 8,
                height: 8,
                decoration: BoxDecoration(
                  color:
                      isLatest
                          ? const Color(0xFF2EBA6F)
                          : stay.isOnlineStart
                          ? darkBrown // warna berbeda untuk online start
                          : const Color(0xFFD8B36A),
                  shape: BoxShape.circle,
                ),
              ),
              if (!isLast)
                Expanded(
                  child: Container(
                    width: 1.5,
                    color: const Color(0xFFD8B36A).withOpacity(0.5),
                    margin: const EdgeInsets.symmetric(vertical: 4),
                  ),
                ),
            ],
          ),
          const SizedBox(width: 16),
          // Konten teks — TANPA badge durasi
          Expanded(
            child: Padding(
              padding: EdgeInsets.only(bottom: isLast ? 0 : 28),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  // Jam saja, tanpa badge di sebelah kanan
                  Text(
                    DateFormat('hh:mm a').format(stay.arrivalTime),
                    style: GoogleFonts.inter(
                      color: Colors.black87,
                      fontWeight: FontWeight.bold,
                      fontSize: 14,
                    ),
                  ),
                  const SizedBox(height: 6),
                  // Nama tempat / shimmer
                  stay.isLoadingPlace
                      ? _buildPlaceNameShimmer()
                      : Text(
                        stay.placeName,
                        style: GoogleFonts.inter(
                          color: isLatest ? darkBrown : Colors.black,
                          fontSize: 16,
                          fontWeight: FontWeight.w800,
                        ),
                      ),

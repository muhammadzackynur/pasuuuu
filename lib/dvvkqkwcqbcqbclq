  Future<void> _fetchCircleMembers() async {
    final session = context.read<SessionController>();
    final currentCircle = session.currentCircle;
    final currentUser = session.currentUser;

    if (currentCircle == null) return;

    try {
      final response = await ApiClient().get(
        '/circles/${currentCircle.id}/members',
        requiresAuth: true,
      );

      List<dynamic> data = [];
      if (response != null && response['data'] is List) {
        data = response['data'] as List<dynamic>;
      }

      if (mounted) {
        setState(() {
          circleMembers = data;
          if (circleMembers.isNotEmpty) {
            final me = circleMembers.firstWhere(
              (m) => m['user_id'] == currentUser?.id,
              orElse: () => circleMembers.first,
            );
            selectedUserId = me['user_id'];
          }
        });
        _fetchLocationHistory(selectedDateIndex);
      }
    } catch (e) {
      debugPrint('Gagal mengambil daftar anggota: $e');
      if (mounted) _fetchLocationHistory(selectedDateIndex);
    }
  }

  Future<void> _fetchLocationHistory(int index) async {
    final session = context.read<SessionController>();
    final currentCircle = session.currentCircle;

    if (currentCircle == null) return;

    if (!session.isPremium) {
      setState(() {
        isLoading = false;
        rawRoutePoints = [];
        timelineStays = [];
      });
      return;
    }

    setState(() {
      isLoading = true;
      rawRoutePoints = [];
      timelineStays = [];
    });

    final now = DateTime.now();
    final date = now.subtract(Duration(days: 6 - index));
    final dateString = DateFormat('yyyy-MM-dd').format(date);

    try {
      String url =
          '/circles/${currentCircle.id}/location-history?date=$dateString';
      if (selectedUserId != null) url += '&user_id=$selectedUserId';

      final response = await ApiClient().get(url, requiresAuth: true);

      List<dynamic> rawData = [];
      if (response != null && response['data'] is List) {
        rawData = response['data'] as List<dynamic>;
      }

      List<dynamic> historyData = [];
      for (var userNode in rawData) {
        if (selectedUserId != null && userNode['user_id'] != selectedUserId)
          continue;
        if (userNode['history'] != null && userNode['history'] is List) {
          historyData.addAll(userNode['history']);
        }
      }

      // Filter hanya tanggal yang dipilih
      historyData =
          historyData.where((item) {
            String dateStr =
                item['recorded_at']?.toString() ??
                item['updated_at']?.toString() ??
                item['created_at']?.toString() ??
                '';
            DateTime? parsedTime = DateTime.tryParse(dateStr);
            if (parsedTime != null) {
              String localDate = DateFormat(
                'yyyy-MM-dd',
              ).format(parsedTime.toLocal());
              return localDate == dateString;
            }
            return false;
          }).toList();

      if (historyData.isEmpty) {
        setState(() => isLoading = false);
        return;
      }

      // Urutkan dari paling lama ke paling baru
      historyData.sort((a, b) {
        String dateAStr =
            a['recorded_at']?.toString() ??
            a['updated_at']?.toString() ??
            a['created_at']?.toString() ??
            '';
        String dateBStr =
            b['recorded_at']?.toString() ??
            b['updated_at']?.toString() ??
            b['created_at']?.toString() ??
            '';
        DateTime timeA = DateTime.tryParse(dateAStr) ?? DateTime.now();
        DateTime timeB = DateTime.tryParse(dateBStr) ?? DateTime.now();
        return timeA.compareTo(timeB);
      });

      final Distance distanceCalc = const Distance();
      List<StayPoint> recordedPoints = [];
      List<LatLng> routes = [];

      // ----------------------------------------------------------------
      // LOGIKA BARU:
      // 1. Titik PERTAMA selalu dicatat sebagai "online start" (titik A)
      // 2. Setiap pergerakan >= 20 meter dari titik terakhir dicatat
      // 3. Gap waktu > 10 menit antar data = dianggap offline lalu online
      //    lagi, sehingga titik berikutnya dicatat sebagai "online start"
      // ----------------------------------------------------------------
      LatLng? lastRecordedCoord;
      DateTime? lastDataTime;
      bool isFirstPoint = true;

      // Threshold gap offline: jika jeda antar data > 10 menit,
      // dianggap user sempat offline
      const int offlineGapMinutes = 10;

      for (var item in historyData) {
        final double lat =
            double.tryParse(item['latitude']?.toString() ?? '0') ?? 0.0;
        final double lng =
            double.tryParse(item['longitude']?.toString() ?? '0') ?? 0.0;
        if (lat == 0.0 && lng == 0.0) continue;

        final point = LatLng(lat, lng);
        String dateStr =
            item['recorded_at']?.toString() ??
            item['updated_at']?.toString() ??
            item['created_at']?.toString() ??
            '';
        final time = (DateTime.tryParse(dateStr) ?? DateTime.now()).toLocal();

        routes.add(point);

        // Cek apakah ini titik pertama atau setelah gap offline
        bool isOnlineStart = false;
        if (isFirstPoint) {
          isOnlineStart = true;
          isFirstPoint = false;
        } else if (lastDataTime != null) {
          final gapMinutes = time.difference(lastDataTime!).inMinutes;
          if (gapMinutes >= offlineGapMinutes) {
            // User sempat offline, lalu online lagi di titik ini
            isOnlineStart = true;
          }
        }

        // Hitung jarak dari titik terakhir yang DICATAT
        double distFromLast = 0.0;
        if (lastRecordedCoord != null) {
          distFromLast =
              distanceCalc.distance(lastRecordedCoord!, point) / 1000;
        }

        final bool movedEnough =
            lastRecordedCoord == null ||
            distanceCalc.distance(lastRecordedCoord!, point) >= 20.0;

        // Catat titik jika:
        // - Ini adalah titik pertama / online start (dari off ke on)
        // - ATAU sudah bergerak >= 20 meter dari titik terakhir yang dicatat
        if (isOnlineStart || movedEnough) {
          recordedPoints.add(
            StayPoint(
              coord: point,
              arrivalTime: time,
              departureTime: time,
              placeName: 'Memuat lokasi...',
              isLoadingPlace: true,
              distanceFromPrevious: distFromLast,
              isOnlineStart: isOnlineStart,
            ),
          );
          lastRecordedCoord = point;
        }

        lastDataTime = time;
      }

      if (recordedPoints.isEmpty) {
        setState(() => isLoading = false);
        return;
      }

      // Balik urutan: terbaru di atas
      final reversedPoints = recordedPoints.reversed.toList();

      setState(() {
        rawRoutePoints = routes;
        timelineStays = reversedPoints;
        isLoading = false;
      });

      _fetchPlaceNames(reversedPoints);
    } catch (e) {
      debugPrint('❌ Error fetch history: $e');
      setState(() => isLoading = false);
    }
  }

  Future<void> _fetchPlaceNames(List<StayPoint> stays) async {
    for (int i = 0; i < stays.length; i++) {
      if (!mounted) return;

      bool success = false;
      int retryCount = 0;

      while (!success && retryCount < 3) {
        try {
          final url = Uri.parse(
            'https://nominatim.openstreetmap.org/reverse'
            '?format=json'
            '&lat=${stays[i].coord.latitude}'
            '&lon=${stays[i].coord.longitude}'
            '&zoom=16'
            '&addressdetails=1',
          );

          final response = await http
              .get(url, headers: {'User-Agent': 'WhereTFApp/1.0'})
              .timeout(const Duration(seconds: 10));

          if (response.statusCode == 200) {
            final data = json.decode(response.body);
            final address = data['address'] as Map<String, dynamic>? ?? {};
            final String placeName = _buildPlaceName(address);

            if (mounted) {
              setState(() {
                stays[i].placeName = placeName;
                stays[i].isLoadingPlace = false;
              });
            }
            success = true;
          } else {
            retryCount++;
            await Future.delayed(Duration(milliseconds: 800 * retryCount));
          }
        } catch (e) {
          retryCount++;
          debugPrint('Geocode error (attempt $retryCount): $e');
          await Future.delayed(Duration(milliseconds: 800 * retryCount));
        }
      }

      if (!success && mounted) {
        setState(() {
          stays[i].placeName =
              '${stays[i].coord.latitude.toStringAsFixed(5)}, '
              '${stays[i].coord.longitude.toStringAsFixed(5)}';
          stays[i].isLoadingPlace = false;
        });
      }

      await Future.delayed(const Duration(milliseconds: 700));
    }
  }

  String _buildPlaceName(Map<String, dynamic> address) {
    final specific =
        address['amenity'] ??
        address['shop'] ??
        address['tourism'] ??
        address['leisure'] ??
        address['building'] ??
        address['office'];

    final road =
        address['road'] ??
        address['pedestrian'] ??
        address['footway'] ??
        address['path'];

    final area =
        address['neighbourhood'] ??
        address['suburb'] ??
        address['quarter'] ??
        address['village'] ??
        address['hamlet'];

    final city =
        address['town'] ??
        address['city'] ??
        address['municipality'] ??
        address['county'];

    final List<String> parts = [];
    if (specific != null) parts.add(specific.toString());
    if (road != null) parts.add(road.toString());
    if (area != null && parts.length < 2) parts.add(area.toString());
    if (city != null && parts.length < 2) parts.add(city.toString());

    if (parts.isNotEmpty) return parts.join(', ');

    return address['county']?.toString() ??
        address['state']?.toString() ??
        'Lokasi tidak diketahui';
  }

